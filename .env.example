# AutoSys Agent – environment variables
# Copy to .env and fill in. .env is gitignored.

# mock | live
AUTOSYS_MODE=mock

# Login gate — single shared credential
AUTH_USERNAME=root
AUTH_PASSWORD=changeme            # change before exposing the app
# SESSION_SECRET=                  # leave unset for dev (auto-generated; sessions won't survive a restart)
# SESSION_TTL_SECONDS=604800       # 7 days

# Live mode — only consulted when AUTOSYS_MODE=live
# AUTOSYS_BASE_URL=https://autosys-prod.example.com:9443/AEWS/
# AUTOSYS_USER=ejmcommander
# AUTOSYS_PASS=
# AUTOSYS_VERIFY_TLS=true            # set to false for self-signed dev certs
# AUTOSYS_TIMEOUT_SECONDS=15
# LOG_FORWARDER_URL_TEMPLATE=https://splunk.example.com/api/jobs/{job}/{stream}
# AUTOSYS_LOG_MOUNT_ROOT=/mnt/autosys-logs   # local dir where agent's job_logs are mounted/synced
# --- SFTP log orchestrator: pull logs off agent hosts directly (needs: pip install '.[ssh]') ---
# AUTOSYS_LOG_SSH_CONFIG=/home/autosys/asysag/log-hosts.json   # JSON map: AutoSys machine -> SSH endpoint
# AUTOSYS_LOG_SSH_MAX_BYTES=65536              # tail this many bytes off the end of each log
# AUTOSYS_LOG_SSH_TIMEOUT_SECONDS=10
# AUTOSYS_LOG_CACHE_TTL_SECONDS=60             # disk cache TTL under state/log_cache
# AUTOSYS_LOG_SSH_KNOWN_HOSTS=/home/autosys/.ssh/known_hosts   # default: system known_hosts
# AUTOSYS_LOG_SSH_INSECURE_SKIP_HOST_KEY=false # true disables host-key verification (not recommended)
# STATUS_CODE_OVERRIDES=99=CUSTOM    # only if the customer AutoSys uses non-standard codes
# AUTOSYS_AUTOREP_HISTORY_STRATEGY=walk-runs   # walk-runs (default) | days-flag

# LiteLLM model identifier — see https://docs.litellm.ai/docs/providers
# Examples:
#   anthropic/claude-sonnet-4-5
#   gemini/gemini-2.5-pro
#   openai/gpt-4o
#   azure/<your-deployment-name>
LITELLM_MODEL=anthropic/claude-sonnet-4-5

# Provider credentials — only the one matching LITELLM_MODEL is needed
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# Backend bind
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
